{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthRateLimit": {
    "PermitPerMinute": 30
  },
  "ExternalApi": {
    "BaseUrl": "https://api.nasa.gov/",
    "ApiKeyLocation": "Query",
    "ApiKeyName": "api_key",
    "ApiKey": "DEMO_KEY",
    "TimeoutSeconds": 15
  }
}